<!DOCTYPE html>
<html>
<head>

<title>Assistant Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>

<div class="container mt-4">

<div class="d-flex justify-content-between">

<h2>
Assistant Dashboard
</h2>

<a href="/logout"
class="btn btn-danger">
Logout
</a>

</div>

<hr>

<div class="card mb-4">

<div class="card-body">

<form action="/entry" method="POST">

<div class="row">

<div class="col-md-5">

<input
type="text"
name="vehicleNo"
placeholder="Vehicle Number"
class="form-control"
required>

</div>

<div class="col-md-5">

<select
name="vehicleType"
class="form-select">

<option>Bike</option>
<option>Car</option>
<option>Truck</option>

</select>

</div>

<div class="col-md-2">

<button class="btn btn-success w-100">
Entry
</button>

</div>

</div>

</form>

</div>

</div>

<table class="table table-bordered">

<thead>

<tr>

<th>Vehicle</th>
<th>Type</th>
<th>Entry</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% vehicles.forEach(vehicle=>{ %>

<tr>

<td>
<%= vehicle.vehicleNo %>
</td>

<td>
<%= vehicle.vehicleType %>
</td>

<td>
<%= vehicle.entryTime.toLocaleString() %>
</td>

<td>

<form
action="/exit/<%= vehicle._id %>"
method="POST">

<button
class="btn btn-warning">
Exit
</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</body>
</html>