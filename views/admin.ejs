<!DOCTYPE html>
<html>
<head>

<title>Admin Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>

<div class="container mt-4">

<div class="d-flex justify-content-between">

<h2>
Admin Dashboard
</h2>

<div>

<a href="/search"
class="btn btn-dark">
Search
</a>

<a href="/logout"
class="btn btn-danger">
Logout
</a>

<a href="/revenue"
class="btn btn-success">
Revenue
</a>

</div>

</div>

<hr>

<h3>
Current Vehicles
</h3>

<table class="table table-bordered">

<tr>

<th>Vehicle</th>
<th>Type</th>
<th>Assistant</th>

</tr>

<% currentVehicles.forEach(vehicle=>{ %>

<tr>

<td>
<%= vehicle.vehicleNo %>
</td>

<td>
<%= vehicle.vehicleType %>
</td>

<td>
<%= vehicle.allowedBy.name %>
</td>

</tr>

<% }) %>

</table>

<hr>

<h3>
Exited Vehicles
</h3>

<table class="table table-bordered">

<tr>

<th>Vehicle</th>
<th>Type</th>
<th>Assistant</th>
<th>Bill</th>

</tr>

<% exitedVehicles.forEach(vehicle=>{ %>

<tr>

<td>
<%= vehicle.vehicleNo %>
</td>

<td>
<%= vehicle.vehicleType %>
</td>

<td>
<%= vehicle.allowedBy.name %>
</td>

<td>

₹<%= vehicle.billAmount %>

</td>

</tr>

<% }) %>

</table>

</div>

</body>
</html>